# Copy to .env.local and fill in. Server-side only: never prefix these with NEXT_PUBLIC_.

# Required. Gnani speech key, from https://app.gnani.ai/voice (needs STT and TTS scope).
GNANI_API_KEY=

# Translation provider: groq (default) or cerebras. Only the chosen provider's key is required.
TRANSLATION_PROVIDER=groq

# Groq key, from https://console.groq.com/keys
GROQ_API_KEY=
# Production models listed in Groq docs include openai/gpt-oss-120b and llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_URL=https://api.groq.com/openai/v1

# Cerebras key, from https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Models listed by Cerebras docs: gpt-oss-120b, qwen-3.8-27b
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_API_URL=https://api.cerebras.ai/v1

# Optional. Defaults are shown; leave blank to use them.
GNANI_STT_URL=https://api.vachana.ai/stt/v3
GNANI_TTS_URL=https://api.vachana.ai/api/v1/tts/inference
